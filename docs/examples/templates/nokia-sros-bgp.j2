{# Nokia SR OS (MD-CLI) BGP Configuration Template #}
{#
   Context Variables (from ConfigRenderer):
   - device: Device dict with name, platform, site
   - sessions: List of session dicts (see README for full schema)
   - peer_groups: List of peer group dicts (id, name)
   - route_maps: List of route map dicts (id, name)

   Note: Nokia SR OS supports policy lists for import/export.
   This template includes all route maps from address_families config.
#}

# BGP Configuration for {{ device.name }}
# Platform: {{ device.platform.name }}
# Site: {{ device.site.name }}

configure {
    router "Base" {
        autonomous-system {{ sessions[0].local_asn if sessions else 'LOCAL_ASN' }}
        router-id {{ device.primary_ip4.address.ip | default('10.0.0.1') }}
{% if peer_groups %}

        # Peer Groups
{% for pg in peer_groups %}
        bgp {
            group "{{ pg.name }}" {
                admin-state enable
            }
        }
{% endfor %}
{% endif %}

        bgp {
            admin-state enable
            rapid-withdrawal true

{% for session in sessions %}
{% if session.enabled %}
            neighbor "{{ session.remote_ip }}" {
                admin-state enable
                description "{{ session.name }}{% if session.description %} - {{ session.description }}{% endif %}"
                peer-as {{ session.peer_asn }}
{% if session.peer_group %}
                group "{{ session.peer_group.name }}"
{% else %}
                group "ebgp-peers"
{% endif %}
{% if session.local_ip %}
                local-address {{ session.local_ip }}
{% endif %}
{% if session.password %}
                authentication-key "{{ session.password }}"
{% endif %}
{% if session.ttl %}
                multihop {{ session.ttl }}
{% endif %}
{% if session.bfd_profile %}
                bfd-liveness {
                    admin-state enable
                    transmit-interval {{ session.bfd_profile.minimum_interval }}
                    receive-interval {{ session.bfd_profile.minimum_rx_interval }}
                    multiplier {{ session.bfd_profile.multiplier }}
                }
{% endif %}
{# Configure address families #}
{% for afi_safi in session.afi_safis | default(['ipv4-unicast']) %}
{% if afi_safi == 'ipv4-unicast' %}
                family {
                    ipv4 true
                }
{% if session.ipv4_max_prefixes %}
                prefix-limit ipv4 {
                    maximum {{ session.ipv4_max_prefixes }}
                }
{% endif %}
{% elif afi_safi == 'ipv6-unicast' %}
                family {
                    ipv6 true
                }
{% if session.ipv6_max_prefixes %}
                prefix-limit ipv6 {
                    maximum {{ session.ipv6_max_prefixes }}
                }
{% endif %}
{% elif afi_safi == 'l3vpn-ipv4-unicast' %}
                family {
                    vpn-ipv4 true
                }
{% elif afi_safi == 'l3vpn-ipv6-unicast' %}
                family {
                    vpn-ipv6 true
                }
{% elif afi_safi == 'evpn' %}
                family {
                    evpn true
                }
{% endif %}
{% endfor %}
{# Apply route maps from address_families config #}
{% set import_policies = [] %}
{% set export_policies = [] %}
{% for af in session.address_families %}
{% if af.route_map_in %}{% if import_policies.append(af.route_map_in.name) %}{% endif %}{% endif %}
{% if af.route_map_out %}{% if export_policies.append(af.route_map_out.name) %}{% endif %}{% endif %}
{% endfor %}
{% if import_policies %}
                import {
                    policy [{% for p in import_policies %}"{{ p }}"{% if not loop.last %} {% endif %}{% endfor %}]
                }
{% endif %}
{% if export_policies %}
                export {
                    policy [{% for p in export_policies %}"{{ p }}"{% if not loop.last %} {% endif %}{% endfor %}]
                }
{% endif %}
            }
{% endif %}
{% endfor %}
        }
    }

{# Policy configuration #}
{% if route_maps %}
    policy-options {
{% for rm in route_maps %}
        policy-statement "{{ rm.name }}" {
            entry 10 {
                action {
                    action-type accept
                }
            }
            default-action {
                action-type reject
            }
        }
{% endfor %}
    }
{% endif %}
}

